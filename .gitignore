# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Pipeline outputs (regenerable)
results/
*.fits
*.fit
*.npz
*.tar.gz
*.tgz
*.zip

# Raw MUSE cubes and exposures (139 GB) — never belongs in git. Written as
# data/* rather than data/ so that git still descends into it: a file inside an
# excluded directory cannot be brought back, and the templates below have to be.
data/*

# The templates a source is fitted against: small, and the pipeline cannot run
# without them. l5v is left out here as it is at run time -- its data starts at
# 5392 A and cannot cover the rest range MUSE needs.
!data/stellar_templates/
data/stellar_templates/l5v.dat
!data/eigen_galaxy_Bolton2012.fits

# Stray figures at the repo root. Keepers go under results/skymodel/figures/,
# which is already covered by results/ above.
/*.png

# Agent tooling config
.codex/

# Downloaded paper PDFs (re-downloadable via docs/paper/README.md arXiv IDs)
*.pdf

# Claude Code session config
.claude/

# Professor's paper text (not for repo)
paper_from_professor.txt